# Development Dockerfile for Backend (Kubernetes)
FROM node:22-alpine

# Create workspace directory structure
RUN mkdir -p /workspace/backend

# Copy ONLY backend package files first (before root package.json)
COPY backend/package.json backend/package-lock.json* /workspace/backend/

# Set working directory to /workspace/backend
WORKDIR /workspace/backend

# Install dependencies for better-sqlite3 compilation and timezone support
# libc6-compat: Required for better-sqlite3 (provides ld-linux-x86-64.so.2 loader)
# libstdc++: Required for better-sqlite3 C++ standard library
RUN apk add --no-cache python3 make g++ tzdata libc6-compat libstdc++

# Install dependencies (including dev dependencies)
RUN npm install

# Rebuild better-sqlite3 from source for Alpine musl compatibility
RUN npm rebuild better-sqlite3

# NOW copy the entire repo for correct import structure
COPY . /workspace/

# Copy backend source code
COPY backend/ /workspace/backend/

# Expose port
EXPOSE 3000

# Start development server with hot reload
CMD ["npm", "run", "dev"]
