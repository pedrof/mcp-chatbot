# Development Dockerfile for Backend
FROM node:22-alpine

WORKDIR /app

# Install dependencies for better-sqlite3 compilation and timezone support
# libc6-compat: Required for better-sqlite3 (provides ld-linux-x86-64.so.2 loader)
# libstdc++: Required for better-sqlite3 C++ standard library
RUN apk add --no-cache python3 make g++ tzdata libc6-compat libstdc++

# Copy package files
COPY package.json ./

# Install dependencies (including dev dependencies)
RUN npm install

# Rebuild better-sqlite3 from source for Alpine musl compatibility
RUN npm rebuild better-sqlite3

# Copy source code
COPY . .

# Expose port
EXPOSE 3000

# Start development server with hot reload
CMD ["npm", "run", "dev"]
