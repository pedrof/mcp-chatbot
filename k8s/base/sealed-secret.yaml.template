# This is a template for the sealed secret
# To create the actual sealed secret, run:
# make kube-create-secret
#
# Or manually:
# kubectl create secret generic mcp-chatbot-secret \
#   --from-literal=APP_SECRET="your-32-char-secret" \
#   --from-literal=JWT_SECRET="your-32-char-secret" \
#   --namespace=mcp-chatbot \
#   --dry-run=client -o yaml | \
# kubeseal --format yaml > k8s/base/sealed-secret.yaml

apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: mcp-chatbot-secret
  namespace: mcp-chatbot
spec:
  encryptedData:
    APP_SECRET: AGEDD2... (replace with actual sealed secret)
    JWT_SECRET: AGEDD2... (replace with actual sealed secret)
  template:
    metadata:
      name: mcp-chatbot-secret
      namespace: mcp-chatbot
    type: Opaque
