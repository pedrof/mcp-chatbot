# MCP Chatbot Environment Configuration
# Copy this file to .env and customize the values

# =============================================================================
# SECURITY - REQUIRED
# =============================================================================
# Encryption key for storing API keys in database (REQUIRED)
# Must be at least 32 characters long
# Generate a secure random string: openssl rand -base64 32
APP_SECRET=change-this-to-a-secure-random-string-at-least-32-characters-long

# JWT secret for user authentication (REQUIRED)
# Must be at least 32 characters long
# Generate a secure random string: openssl rand -base64 32
# If not set, will use APP_SECRET as fallback (not recommended for production)
JWT_SECRET=change-this-to-a-different-secure-random-string-at-least-32-chars

# =============================================================================
# BACKEND CONFIGURATION
# =============================================================================
# Port for backend API server
PORT=3000

# Environment (development, production)
NODE_ENV=development

# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:5173

# Database file path (inside container)
DATABASE_PATH=/app/data/config.db

# Timezone for server (affects date handling for MCP tools)
TZ=America/New_York

# =============================================================================
# AIR-GAP NETWORK CONFIGURATION
# =============================================================================
# NPM Registry Configuration
# For air-gap networks, point to your internal npm registry
# Default: https://registry.npmjs.org/
# Example internal registry: http://nexus.company.com:8081/repository/npm-proxy/
NPM_CONFIG_REGISTRY=https://registry.npmjs.org/

# NPM Registry for @modelcontextprotocol packages (optional)
# If your scoped packages are in a different registry
# NPM_CONFIG_@MODELCONTEXTPROTOCOL:REGISTRY=https://registry.npmjs.org/

# Additional NPM Configuration
# Disable SSL verification (NOT recommended for production)
# NPM_CONFIG_STRICT_SSL=false

# Set npm registry token for private registries (optional)
# NPM_CONFIG_//YOUR_REGISTRY:_AUTHTOKEN=your-token-here

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# Backend API URL (from frontend perspective)
VITE_API_URL=http://localhost:3000/api

# =============================================================================
# NOTES
# =============================================================================
# Air-Gap Network Setup:
# 1. Set NPM_CONFIG_REGISTRY to your internal npm mirror/proxy
# 2. Ensure your internal registry has these packages:
#    - @modelcontextprotocol/sdk
#    - @modelcontextprotocol/server-filesystem (if using filesystem MCP)
#    - Any other MCP servers you plan to use
# 3. For Podman/Docker builds, the registry is used during npm install
# 4. For MCP stdio servers using 'npx', the registry is used at runtime
# 5. Consider pre-caching packages: npx -y @modelcontextprotocol/server-filesystem
