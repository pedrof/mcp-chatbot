# Development Dockerfile for Frontend
FROM node:22-alpine

# Create workspace directory
RUN mkdir -p /workspace

# Copy ONLY frontend package files first (before root package.json)
COPY frontend/package.json frontend/package-lock.json* /workspace/

# Set working directory
WORKDIR /workspace

# Install ALL dependencies (including devDependencies for Vite)
# This runs in isolation, so workspace config won't interfere
RUN npm install --legacy-peer-deps

# NOW copy the entire repo for correct import structure
COPY . /workspace/

# Copy frontend source code
COPY frontend/ /workspace/

# Expose Vite dev server port
EXPOSE 5173

# Start development server
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
