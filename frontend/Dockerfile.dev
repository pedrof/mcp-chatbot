# Development Dockerfile for Frontend (Kubernetes)
FROM node:22-alpine

# Create workspace directory structure
RUN mkdir -p /workspace/frontend

# Copy ONLY frontend package files first (before root package.json)
COPY frontend/package.json frontend/package-lock.json* /workspace/frontend/

# Set working directory to /workspace/frontend
WORKDIR /workspace/frontend

# Install ALL dependencies (including devDependencies for Vite)
# This runs in isolation, so workspace config won't interfere
# Explicitly install rollup native binary to avoid optional dependency bug
RUN npm install --legacy-peer-deps && \
    npm install --no-save @rollup/rollup-linux-x64-musl

# NOW copy the entire repo for correct import structure
COPY . /workspace/

# Copy frontend source code
COPY frontend/ /workspace/frontend/

# Expose Vite dev server port
EXPOSE 5173

# Start development server
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
